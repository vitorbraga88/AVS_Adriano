# === AVS SOLUÇÕES ELÉTRICAS — ADMIN ===
# Senha do painel (usuário fixo: admin). Sem senha -> API responde 503.
ADMIN_PASSWORD=troque-esta-senha
# AVS_DEV=1  # somente dev local: libera SEM ADMIN_PASSWORD (NUNCA em produção)

# URL pública do app (usada nos botões do bot e nos links de PDF)
PUBLIC_BASE_URL=https://servidor-203.tail43f430.ts.net/avs

# === n8n (entrega de PDF + resumo ao Telegram/WhatsApp do dono) ===
# Base dos webhooks; o app faz POST em {N8N_WEBHOOK_BASE}/avs-orcamento e /avs-os
N8N_WEBHOOK_BASE=http://127.0.0.1:5678/webhook

# === BOT TELEGRAM (opcional; sem token o bot fica inativo) ===
# TELEGRAM_BOT_TOKEN=123456:ABC...   (gerar com @BotFather)
# TELEGRAM_CHAT_IDS=5118460498       (chat_ids autorizados do dono, CSV)
